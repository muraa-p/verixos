{
  "name": "verixos",
  "version": "0.1.0",
  "description": "VerixOS - a general-purpose operating system built on a faithful x86-64 machine model",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "dist/main.js",
  "bin": {
    "verix": "./dist/main.js"
  },
  "files": [
    "dist",
    "images",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "run": "node --experimental-strip-types --no-warnings src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:watch": "node --experimental-strip-types --no-warnings --test --watch tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "image": "node --experimental-strip-types --no-warnings tools/build-image.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('images',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verixos/verixos.git"
  },
  "bugs": {
    "url": "https://github.com/verixos/verixos/issues"
  },
  "homepage": "https://github.com/verixos/verixos#readme",
  "keywords": [
    "operating-system",
    "kernel",
    "x86-64",
    "x86_64",
    "virtual-memory",
    "scheduler",
    "interrupts",
    "emulator",
    "systems-programming"
  ]
}